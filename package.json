{
  "name": "ascendra-commons",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable NestJS backend patterns for Ascendra-umbrella projects (Next.js/NestJS/Drizzle/Supabase stack). Copy-based distribution, not an npm package.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.js",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/throttler": "^6.7.1",
    "@supabase/supabase-js": "^2.110.7",
    "drizzle-orm": "^0.45.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  }
}
